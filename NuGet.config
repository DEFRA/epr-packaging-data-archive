<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pinned to nuget.org only.

    Without <clear />, restore inherits the machine-level source list. Developers who also work on the
    Azure-hosted EPR services have DEFRA's private Azure DevOps feed (defra-epr-common) configured there.
    That feed returns 401 without a PAT, and NuGet treats an unreachable source as a hard failure (NU1301),
    so a plain `dotnet restore` fails after several minutes even though every package here is on nuget.org.

    This service takes no dependency on the private feed, and CDP builds run on GitHub Actions with no
    Azure DevOps credentials, so a private-feed dependency could not build in CI anyway. If one is ever
    genuinely needed, the feed has to be added here *and* authenticated in the build workflow.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
